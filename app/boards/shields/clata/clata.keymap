#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        bindings = <
   &kp ESC   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6     &kp N7  &kp N8   &kp N9    &kp N0
   &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Z      &kp U   &kp I    &kp O     &kp P
   &kp CAPS  &kp A     &kp S     &kp D     &kp F     &kp G     &kp H      &kp J   &kp K    &kp L     &kp BSPC
   &kp LSHFT &kp EQUAL &kp Y     &kp X     &kp C     &kp V     &kp B      &kp N   &kp M    &kp FSLH  &kp RET
   &kp LGUI  &kp LALT  &kp MINUS &kp GRAVE &none     &kp SPACE &none      &kp SQT &kp SEMI &kp COMMA &kp PERIOD
                        >;
                };
        };
};
